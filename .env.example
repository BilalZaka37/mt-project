# MT Project — generate a URL-safe database password and a Fernet key. No defaults.
MT_DB_PASSWORD=replace_with_long_random_url_safe_password
MT_ENCRYPTION_KEY=replace_with_fernet_key
MT_MODEL_PATH=/data/models/yolo11n.pt
MT_SECURE_COOKIE=false
MT_MAX_CAMERAS=8
MT_RETENTION_DAYS=7
MT_MEDIA_QUOTA_MB=10240
MT_UPLOAD_MB=512
MT_SEGMENT_SECONDS=30
MT_CLIP_PRE_SECONDS=3
MT_CLIP_POST_SECONDS=5
# Explicit comma-separated receiver hostnames. Blank disables new webhook destinations.
MT_WEBHOOK_ALLOWED_HOSTS=
# Development loopback HTTP only; HTTPS remains required for other hosts.
MT_ALLOW_LOCAL_WEBHOOKS=false
MT_ALERT_RETRY_SECONDS=5
